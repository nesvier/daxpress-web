@* Bloque de llamada a la acción que cierra casi todas las páginas. *@
<section class="cta">
    <div class="contenedor cta__caja">
        <div>
            <h2>¿Tu equipo repite las mismas tareas todas las semanas?</h2>
            <p>Agendá un diagnóstico sin costo: relevamos tus procesos y te decimos qué podés automatizar y cuánto costaría.</p>
        </div>
        <div class="cta__acciones">
            <a class="boton" href="/contacto">Agendar diagnóstico</a>
            @if (!string.IsNullOrEmpty(SiteOpts.Value.WhatsApp))
            {
                <a class="boton boton--claro" href="@SiteOpts.Value.WhatsAppUrl()" rel="noopener" target="_blank">Escribinos por WhatsApp</a>
            }
        </div>
    </div>
</section>
