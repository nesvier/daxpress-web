@{
    var site = SiteOpts.Value;
    var titulo = ViewData["Title"] as string;
    var tituloCompleto = string.IsNullOrEmpty(titulo) ? "Daxpress — Automatización y software a medida para pymes" : $"{titulo} | Daxpress";
    var descripcion = ViewData["Description"] as string
        ?? "Automatizamos tareas administrativas de pymes en Montevideo con software a medida: stock, reservas, cobros y facturación electrónica. Diagnóstico sin costo.";
    var canonical = site.BaseUrl + (Context.Request.Path.Value is "/" or null ? "/" : Context.Request.Path.Value);
    var ruta = Context.Request.Path.Value ?? "/";
    string Activo(string prefijo) => ruta.StartsWith(prefijo, StringComparison.OrdinalIgnoreCase) ? "activo" : "";
}
<!DOCTYPE html>
<html lang="es-UY">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@tituloCompleto</title>
    <meta name="description" content="@descripcion" />
    <link rel="canonical" href="@canonical" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:site_name" content="Daxpress" />
    <meta property="og:title" content="@tituloCompleto" />
    <meta property="og:description" content="@descripcion" />
    <meta property="og:url" content="@canonical" />
    <meta name="theme-color" content="#0f1f33" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "ProfessionalService",
      "name": "Daxpress",
      "description": "Automatización de tareas administrativas y software a medida para pymes.",
      "url": "@site.BaseUrl",
      @if (!string.IsNullOrEmpty(site.Email)) { <text>"email": "@site.Email",</text> }
      @if (!string.IsNullOrEmpty(site.WhatsApp)) { <text>"telephone": "+@site.WhatsApp",</text> }
      "areaServed": { "@@type": "Country", "name": "Uruguay" },
      "address": { "@@type": "PostalAddress", "addressLocality": "@site.Ciudad", "addressCountry": "UY" }
    }
    </script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
        <div class="contenedor cabecera__fila">
            <a class="logo" href="/" aria-label="Daxpress, inicio">dax<span>press</span></a>
            <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-hidden="true" />
            <label for="menu-toggle" class="menu-boton" aria-label="Abrir menú"><span></span></label>
            <nav class="nav" aria-label="Principal">
                <a class="@Activo("/servicios")" href="/servicios">Servicios</a>
                <a class="@Activo("/sectores")" href="/sectores">Sectores</a>
                <a class="@Activo("/casos")" href="/casos">Casos</a>
                <a class="@Activo("/blog")" href="/blog">Blog</a>
                <a class="boton boton--chico" href="/contacto">Diagnóstico sin costo</a>
            </nav>
        </div>
    </header>

    <main id="contenido">
        @RenderBody()
    </main>

    <footer class="pie">
        <div class="contenedor pie__grilla">
            <div>
                <a class="logo logo--claro" href="/">dax<span>press</span></a>
                <p>Automatización de tareas administrativas y software a medida para pymes de @site.Ciudad y todo Uruguay.</p>
            </div>
            <div>
                <h2>Servicios</h2>
                <ul>
                    @foreach (var s in SiteContent.Servicios)
                    {
                        <li><a href="/servicios/@s.Slug">@s.Nombre</a></li>
                    }
                </ul>
            </div>
            <div>
                <h2>Sectores</h2>
                <ul>
                    @foreach (var s in SiteContent.Sectores)
                    {
                        <li><a href="/sectores/@s.Slug">@s.Nombre</a></li>
                    }
                </ul>
            </div>
            <div>
                <h2>Contacto</h2>
                <ul>
                    <li><a href="/contacto">Agendar diagnóstico</a></li>
                    @if (!string.IsNullOrEmpty(site.Email))
                    {
                        <li><a href="mailto:@site.Email">@site.Email</a></li>
                    }
                    @if (!string.IsNullOrEmpty(site.WhatsApp))
                    {
                        <li><a href="@site.WhatsAppUrl()" rel="noopener" target="_blank">WhatsApp</a></li>
                    }
                    <li>@site.Ciudad, Uruguay</li>
                </ul>
            </div>
        </div>
        <div class="contenedor pie__legal">© @DateTime.Now.Year Daxpress · Precios en USD más IVA</div>
    </footer>

    @if (!string.IsNullOrEmpty(site.WhatsApp))
    {
        <a class="whatsapp-flotante" href="@site.WhatsAppUrl()" rel="noopener" target="_blank" aria-label="Escribinos por WhatsApp">
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.5 4c1.7.7 2.3.8 3.1.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.2Z"/></svg>
        </a>
    }
</body>
</html>
